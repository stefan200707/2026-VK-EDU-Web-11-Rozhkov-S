SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# подключение Django к PostgreSQL
# .env.local: DB_HOST=localhost, DB_PORT=5433; .env.docker: DB_HOST=db, DB_PORT=5432
DB_NAME=askpupkin
DB_USER=askpupkin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# с этими данными сервис db создаёт базу при первом запуске (нужны в .env.docker)
POSTGRES_DB=askpupkin
POSTGRES_USER=askpupkin
POSTGRES_PASSWORD=change-me
